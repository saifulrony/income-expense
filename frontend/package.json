{
  "name": "income-expense-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 18000",
    "build": "rm -f public/*.apk public/*.APK out/*.apk && NEXT_EXPORT=true next build",
    "start": "next start -p 18000",
    "lint": "next lint",
    "cap:sync": "rm -f public/*.apk public/*.APK out/*.apk && NEXT_EXPORT=true next build && npx cap sync",
    "cap:android": "NEXT_EXPORT=true next build && npx cap add android || npx cap sync android",
    "cap:open": "npx cap open android",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^14.1.2",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.73.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^7.6.10",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
