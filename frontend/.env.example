# CashFlow Frontend Environment Variables

# Backend API Base URL
# - For local testing over Wi-Fi: http://<your-local-ip>:18080/api (e.g. http://192.168.177.131:18080/api)
# - For production cloud: https://api.yourdomain.com/api
# - For local desktop browser only: leave empty or use http://localhost:18080/api
NEXT_PUBLIC_API_URL=http://localhost:18080/api

# Frontend Next.js Dev Server Port
PORT=18000

# ==============================================================================
# Google Play Billing (via RevenueCat — Free up to $2,500/mo revenue)
# ==============================================================================
# Paste your RevenueCat Android Public API Key (starts with goog_...)
NEXT_PUBLIC_REVENUECAT_ANDROID_KEY=
# Google Play Console In-App Product ID (One-Time Lifetime Pro)
NEXT_PUBLIC_PLAY_LIFETIME_SKU=cashflow_lifetime_pro
# Display price fallback when running outside Play Store
NEXT_PUBLIC_LIFETIME_PRICE_DISPLAY=$4.99

# ==============================================================================
# Google AdMob (Opt-In Rewarded Video Ads for 7-Day Free Pro Pass)
# ==============================================================================
# Paste your AdMob Rewarded Ad Unit ID (ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx)
NEXT_PUBLIC_ADMOB_REWARDED_ID=

# Optional custom Ad Server URL (leave blank in Play Store builds)
NEXT_PUBLIC_AD_SERVER_URL=
