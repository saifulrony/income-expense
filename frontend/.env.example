# CashFlow Frontend Environment Variables

# Backend API Base URL
# - For local testing over Wi-Fi: http://<your-local-ip>:18080/api (e.g. http://192.168.177.131:18080/api)
# - For production cloud: https://api.yourdomain.com/api
# - For local desktop browser only: leave empty or use http://localhost:18080/api
NEXT_PUBLIC_API_URL=http://localhost:18080/api

# Frontend Next.js Dev Server Port
PORT=18000
