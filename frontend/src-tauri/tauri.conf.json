{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CashFlow",
  "version": "2.0.4",
  "identifier": "com.cashflow.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:18000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "CashFlow - Personal & Business Finance",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Personal & Business Income Expense Tracker",
    "longDescription": "Modern offline-first double entry income and expense manager with visual ledgers, analytics, and budgeting."
  }
}
