# CashFlow Backend Environment Variables

# The port on which the Go HTTP API server listens (default: 18080)
PORT=18080

# Secret key used to sign and verify JWT authentication tokens
# (Generate a long, random string in production)
JWT_SECRET=super-secret-secure-key-income-expense-mobile-2025

# Gin Mode: 'debug' for detailed logs during development, 'release' for high performance
GIN_MODE=release
